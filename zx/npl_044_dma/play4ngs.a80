;……•Ž„ € ‘‹…„“™ˆ‰ …‘ŸŠ
NEXTPL		LD BC,(STOP_PL+1)
		INC BC
		LD HL,(KOLWMP3)
		LD A,H
		OR L
		RET Z
		AND A
		SBC HL,BC
		JR NZ,$+5
		LD BC,0
		LD (STOP_PL+1),BC
		JP INIPLAY

;……•Ž„ € …„›„“™ˆ‰ …‘ŸŠ
PREVPL		LD BC,(STOP_PL+1)
		LD A,B
		OR C
		JR NZ,PREVPL1
		LD BC,(KOLWMP3)
		LD A,B
		OR C
		RET Z
PREVPL1		DEC BC
		LD (STOP_PL+1),BC
		JP INIPLAY

;……•Ž„ € …‚›‰ ”€‰‹ ‘‹…„“™…‰ DIR
NEXTDIR		LD BC,(STOP_PL+1)
		LD A,9
