		JP COM__SD

;……Š‹ž—…ˆ… VIRTUAL SURROUND
XORSURR		LD B,1
XOR_ALL		PUSH BC
		LD HL,0X0300
		LD A,0X0A
		CALL COM__SD
		POP BC
		LD A,E
		XOR B
		LD E,A
		LD A,(GET_VTS+2)
		XOR B
		LD (GET_VTS+2),A
		BIT 3,A
		JR Z,$+4
		RES 7,E
		LD HL,0X0200
		LD A,0X0A
		JP COM__SD

;……Š‹ž—…ˆ… ’…ŒŽ‚
XORBASS		LD A,(GET_VTS+2)
