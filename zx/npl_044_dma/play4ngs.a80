		LD (GET_VTS+2),A

CP_XB		LD A,(GET_VTS+2)
		BIT 7,A
		JR Z,XB1
VS_TBL		LD DE,0
XB2		LD HL,0X0202
		LD A,0X0A
		JP COM__SD

XB1		LD HL,0X0302
		LD A,0X0A
		CALL COM__SD
