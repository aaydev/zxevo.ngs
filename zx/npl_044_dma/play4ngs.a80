;‚›Š‹/‚Š‹ ‡‚“Š€
MUTE		LD HL,0X030B
		LD A,0X0A
		CALL COM__SD
		LD A,E
		CP 0XFE
		JR NC,MUTEOFF
		LD (MUTEOFF+1),A
		LD HL,GET_VTS+2
		SET 6,(HL)
		LD E,0XFE
		JR VOL_ALL

MUTEOFF		LD E,0
		LD HL,GET_VTS+2
		RES 6,(HL)
		JR VOL_ALL

;“‚…‹ˆ—…ˆ… ƒŽŒŠŽ‘’ˆ € …„ˆˆ–“
VOL_UP		LD HL,0X030B
		LD A,0X0A
		CALL COM__SD
		LD A,E
		AND A
		RET Z
		CP 0X80
		RET NC
		DEC E
		JR VOL_ALL

;“Œ…œ˜…ˆ… ƒŽŒŠŽ‘’ˆ € …„ˆˆ–“
VOL_DN		LD HL,0X030B
