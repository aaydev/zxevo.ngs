		IN A,(DAMNPORT1)

;Ž‘Ž‚ŒŽ‰ –ˆŠ‹ Ž™…ˆŸ ‘Ž ‘…ŠŽŒ
OPROS		IN A,(ZXSTAT)
		RRA
		JR C,OPROS1
		CALL PLAYMP3
		JR OPROS

OPROS1		IN A,(CLRCBIT)
		IN A,(ZXCMD)
		LD L,A
		AND A
		JR Z,OPROS2
		LD A,(REJIMGS)
		CP 0X78
		JR NC,OPROS
		LD A,L
OPROS2		CP LOW ((END_TAB-TABFUNC)/2)+1
		JR NC,OPROS
		ADD A,A
		LD L,A
		LD H,0
		LD DE,TABFUNC
		ADD HL,DE
		LD E,(HL)
		INC HL
		LD D,(HL)
		LD HL,OPROS
		PUSH HL
		EX DE,HL
		JP (HL)

